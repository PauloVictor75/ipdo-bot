# Copie para .env e preencha. O .env nunca vai para o git.

# SMTP com SSL (porta 465)
EMAIL_USER=robo@seudominio.com
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.zoho.com
EMAIL_SMTP_PORT=465

# Destinatários, separados por vírgula
IPDO_EMAIL_TO=equipe@seudominio.com,outra.pessoa@seudominio.com

# Opcional: Web App do Google Apps Script que recebe o PDF (JSON com pdf_base64) e guarda no Drive
IPDO_DRIVE_WEBHOOK_URL=

# Opcional: visual do e-mail
IPDO_REMETENTE=IPDO Bot
IPDO_CABECALHO_URL=

# Opcional: .env separado com as credenciais de e-mail, compartilhado com outros robôs
# IPDO_CREDENCIAIS=/caminho/para/credenciais.env
